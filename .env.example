# uza-mobility-admin — staff platform (Next.js)
# Every variable this app reads. Nothing else is consulted.
# See 04-uza-cloud/deploy-env.md in the guide repository for the cross-project rules.

NODE_ENV=production

# This app's own public address.
# Must EXACTLY match ADMIN_FRONTEND_URL on the API, and its origin must appear in the API's CORS_ORIGINS.
NEXT_PUBLIC_APP_URL=https://admin.uzamobility.com

# The API's public address. No trailing slash. Baked in at build time.
NEXT_PUBLIC_API_URL=https://api.uzamobility.com

# Auth.js session-cookie signing secret. Generate: openssl rand -base64 48
# Must differ from the customer app's AUTH_SECRET — a shared secret lets a customer session
# cookie be presented to the staff app.
AUTH_SECRET=

# Optional. Extra https hosts next/image may load from, comma-separated.
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=
